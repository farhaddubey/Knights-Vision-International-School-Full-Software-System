model BoardExam {
  id             Int          @id @default(autoincrement())
  title          String       @db.VarChar(100) // e.g., "Final Board Exam - English"
  classSubject   ClassSubject @relation(fields: [classSubjectId], references: [id])
  classSubjectId Int

  examDate     DateTime
  totalMarks   Int      @default(100)
  syllabus     String?  @db.VarChar(300)
  academicYear Int      @default(2025)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  BoardExamResult BoardExamResult[]

  @@unique([classSubjectId, title]) // One title per subject
}

model BoardExamResult {
  id          Int       @id @default(autoincrement())
  boardExam   BoardExam @relation(fields: [boardExamId], references: [id])
  boardExamId Int

  student   Student @relation(fields: [studentId], references: [id])
  studentId Int

  writtenMarks Float // Out of 90
  oralMarks    Float // Out of 10
  totalMarks   Float // Optional derived: written + oral
  remarks      String? @db.VarChar(200)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, boardExamId]) // Prevents duplicate results
}

model RoleDuty {
  id              Int              @id @default(autoincrement())
  role            UserRole
  description     String           @db.Text
  scope           String           @db.VarChar(50)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  dutyAssignments DutyAssignment[]

  @@unique([role, description])
  @@index([role])
}

model DutyAssignment {
  id         Int          @id @default(autoincrement())
  user       User         @relation(fields: [userId], references: [id])
  userId     Int
  roleDuty   RoleDuty     @relation(fields: [roleDutyId], references: [id])
  roleDutyId Int
  class      SchoolClass? @relation(fields: [classId], references: [id])
  classId    Int?
  branchId   Int?
  schoolId   Int?
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([userId])
  @@index([roleDutyId])
  @@index([classId])
  @@index([branchId])
}

model BranchRoleAssignment {
  id        Int          @id @default(autoincrement())
  user      User         @relation(fields: [userId], references: [id])
  userId    Int
  branch    SchoolBranch @relation(fields: [branchId], references: [id])
  branchId  Int
  schoolId  Int
  role      UserRole
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([branchId, role])
  @@index([userId])
  @@index([branchId])
  @@index([role])
}

model SportsEvent {
  id             Int           @id @default(autoincrement())
  class          SchoolClass   @relation(fields: [classId], references: [id])
  classId        Int
  classSubject   ClassSubject? @relation(fields: [classSubjectId], references: [id])
  classSubjectId Int?
  branchId       Int
  schoolId       Int
  name           String        @db.VarChar(100)
  type           String        @db.VarChar(50)
  date           DateTime
  liveStreamUrl  String?       @db.VarChar(300)
  participants   Json?
  results        Json?
  manager        User?         @relation("EventManager", fields: [managerId], references: [id])
  managerId      Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([classId])
  @@index([branchId])
  @@index([schoolId])
  @@index([managerId])
}

model TeacherSubjectAssignment {
  id           Int      @id @default(autoincrement())
  teacher      User     @relation("AssignedTeacher", fields: [teacherId], references: [id])
  teacherId    Int
  subjectId    Int
  assignedBy   User?    @relation("AssignmentGivenBy", fields: [assignedById], references: [id])
