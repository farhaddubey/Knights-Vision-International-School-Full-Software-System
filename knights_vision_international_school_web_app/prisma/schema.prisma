  allowances           Decimal? @db.Decimal(10, 2)
  total_late_deduction Decimal? @db.Decimal(10, 2)
  total_overtime_bonus Decimal? @db.Decimal(10, 2)
  total_sell_bonus     Decimal? @db.Decimal(10, 2)

  month_year                DateTime? @db.Date
  net_salary                Decimal?  @db.Decimal(10, 2)
  salary_paid               Decimal?  @db.Decimal(10, 2)
  remaining_salary_of_month Decimal?  @db.Decimal(10, 2)

  // Foreign key to User
