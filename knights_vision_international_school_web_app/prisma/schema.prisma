  status        EnterpriseScopeStatus @default(ACTIVE)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  organizations OrganizationProfile[]

  @@index([status])
}

model OrganizationProfile {
  id             Int                     @id @default(autoincrement())
  publicId       String                  @unique @default(uuid()) @db.Uuid
  groupId        Int?
  legacySchoolId Int                     @unique
  code           String                  @unique @db.VarChar(100)
  displayName    String                  @db.VarChar(200)
  legalName      String?                 @db.VarChar(200)
  status         EnterpriseScopeStatus   @default(ACTIVE)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  group          SchoolGroup?            @relation(fields: [groupId], references: [id], onDelete: Restrict)
  legacySchool   School                  @relation("OrganizationProfileSchool", fields: [legacySchoolId], references: [id], onDelete: Restrict)
  regions        OrganizationRegion[]
  branchScopes   EnterpriseBranchScope[]

  @@index([groupId, status])
}

model OrganizationRegion {
  id             Int                     @id @default(autoincrement())
  publicId       String                  @unique @default(uuid()) @db.Uuid
  organizationId Int
  code           String                  @db.VarChar(100)
  name           String                  @db.VarChar(200)
  status         EnterpriseScopeStatus   @default(ACTIVE)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  organization   OrganizationProfile     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branchScopes   EnterpriseBranchScope[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

// The branch scope is optional during rollout. When present it provides a
// canonical enterprise scope around the unchanged SchoolBranch row.
model EnterpriseBranchScope {
  id             Int                   @id @default(autoincrement())
  publicId       String                @unique @default(uuid()) @db.Uuid
  organizationId Int
  regionId       Int?
  branchId       Int                   @unique
  code           String                @db.VarChar(100)
  status         EnterpriseScopeStatus @default(ACTIVE)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  organization   OrganizationProfile   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  region         OrganizationRegion?   @relation(fields: [regionId], references: [id], onDelete: Restrict)
  branch         SchoolBranch          @relation("EnterpriseBranchScopeBranch", fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([organizationId, code])
  @@index([regionId, status])
}

// Policy versions are data, not hard-coded role names. Phase 2 provides the
// registry only; approval workflows will consume it in a later phase.
model AccessPolicyVersion {
  id            Int                @id @default(autoincrement())
  policyKey     String             @db.VarChar(100)
  version       Int
  status        AccessPolicyStatus @default(DRAFT)
  description   String?            @db.Text
  rules         Json?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([policyKey, version])
  @@index([policyKey, status])
}

// New high-assurance operations can use this append-only event store while
// legacy access events remain available in AccessAuditLog.
model EnterpriseAuditEvent {
  id            BigInt                 @id @default(autoincrement())
  publicId      String                 @unique @default(uuid()) @db.Uuid
  actorUserId   Int?
  action        String                 @db.VarChar(150)
  resource      String                 @db.VarChar(100)
  resourceId    String?                @db.VarChar(100)
  outcome       EnterpriseAuditOutcome @default(SUCCESS)
  correlationId String?                @db.VarChar(100)
  scopeType     AccessScopeType?
  schoolId      Int?
  branchId      Int?
  classId       Int?
  beforeData    Json?
  afterData     Json?
  metadata      Json?
  createdAt     DateTime               @default(now())

  @@index([actorUserId, createdAt])
  @@index([resource, resourceId])
  @@index([correlationId])
  @@index([scopeType, schoolId, branchId, classId])
}
