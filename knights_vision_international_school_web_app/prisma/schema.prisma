  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([teacherId, subjectId])
  @@index([teacherId])
  @@index([subjectId])
}

// Compatibility-safe workforce ledger. Existing UserAccessRole, SchoolClass,
// ClassSubject, and TeacherSubjectAssignment records remain the source inputs
// during rollout and are mirrored here by the Phase 3 sync script.
model WorkforceAssignment {
  id              Int                       @id @default(autoincrement())
  publicId        String                    @unique @default(uuid()) @db.Uuid
  userId          Int
  assignmentKind  WorkforceAssignmentKind
  roleCode        String?                   @db.VarChar(100)
  schoolId        Int?
  branchId        Int?
  departmentId    Int?
  classId         Int?
  subjectId       Int?
  classSubjectId  Int?
  source          WorkforceAssignmentSource
  sourceReference String                    @unique @db.VarChar(160)
  startsAt        DateTime?
  endsAt          DateTime?
  isActive        Boolean                   @default(true)
  assignedById    Int?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  user            User                      @relation("WorkforceAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([assignmentKind, isActive])
  @@index([schoolId, branchId, classId])
  @@index([classSubjectId])
  @@index([source, isActive])
}

