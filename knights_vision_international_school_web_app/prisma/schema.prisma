model FleetVehicle {
  id                 Int              @id @default(autoincrement())
  schoolId           Int
  branchId           Int
  school             School           @relation(fields: [schoolId], references: [id])
  branch             SchoolBranch     @relation(fields: [branchId], references: [id])
  // Identification
  registrationNumber String           @unique
  chassisNumber      String           @unique
  engineNumber       String           @unique
  vinNumber          String?          @unique
  vehicleType        VehicleType // CAR, TRUCK, VAN, etc.
  make               String // e.g. Tata, Toyota
  model              String // e.g. Ace, Fortuner
  variant            String? // e.g. Diesel Auto
  fuelType           FuelType // PETROL, DIESEL, EV, HYBRID
  transmissionType   TransmissionType // MANUAL, AUTOMATIC
  color              String?
  seatingCapacity    Int
  loadingCapacityKg  Int? // For trucks, payload in kg

  // Legal & Compliance
  registrationDate      DateTime
  modelYear             Int
  rcExpiryDate          DateTime
  fitnessExpiryDate     DateTime
  insuranceCompany      String?
  insurancePolicyNumber String?
  insuranceExpiryDate   DateTime
  pucExpiryDate         DateTime
  permitType            String? // e.g. National, State
  permitExpiryDate      DateTime

  // Operational Tracking
  odometer           Int       @default(0)
  lastServiceDate    DateTime?
  nextServiceDueDate DateTime?
  warrantyExpiryDate DateTime?
  leaseExpiryDate    DateTime?

  // Status & Lifecycle
  status           VehicleStatus @default(ACTIVE)
  ownershipType    OwnershipType // OWNED, LEASED, RENTED
  decommissionDate DateTime?
  remarks          String?

  // Relational
  assignedDriverId  Int?
  assignedDriver    User?             @relation("DriverAssigned", fields: [assignedDriverId], references: [id])
  depotId           Int?
  depot             Depot?            @relation(fields: [depotId], references: [id])
  documents         VehicleDocument[]
  maintenanceLogs   MaintenanceLog[]
  gpsDeviceId       String? // External GPS system ID
  telematicsProfile Json?

  // Admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, branchId])
}

model Depot {
  id            Int          @id @default(autoincrement())
  schoolId      Int
  branchId      Int
  school        School       @relation(fields: [schoolId], references: [id])
  branch        SchoolBranch @relation(fields: [branchId], references: [id])
  name          String
  location      String // City, GPS coordinates, etc.
  address       String?
  contactNumber String?

  vehicles FleetVehicle[] // One-to-many: One depot can have many vehicles

  @@unique([schoolId, branchId, name])
  @@index([schoolId, branchId])
}

enum VehicleType {
  CAR
  SUV
  VAN
  TRUCK
  PICKUP
  BIKE
  ELECTRIC_CAR
  BUS
  FORKLIFT
  TRACTOR
  OTHER
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  CNG
  LPG
  OTHER
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
  SEMI_AUTOMATIC
  CVT
  OTHER
}

enum OwnershipType {
  OWNED
  LEASED
  RENTED
  FINANCED
}

enum VehicleStatus {
  ACTIVE
  IN_MAINTENANCE
  DECOMMISSIONED
  SOLD
  SCRAPPED
}

model VehicleDocument {
