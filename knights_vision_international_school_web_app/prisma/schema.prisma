enum AssignmentQualityTag {
  EXCELLENT
  GOOD
  NEEDS_IMPROVEMENT
  PLAGIARIZED
  ILLEGIBLE_HANDWRITING // ✍️ Handwriting too poor to read
  NO_STRUCTURE_OR_FORMAT // 😵 Just a wall of text, no paragraphs, bullets, or sections
  LACKS_VISUAL_ELEMENTS // 📉 No diagrams, charts, or visual aids used
  COPY_PASTE_FROM_BOOK // 📚 Looks lifted straight from textbook
  VERY_SHORT_OR_INCOMPLETE // 📏 Minimal effort, partial answers
  CREATIVELY_PRESENTED // 🌈 Nicely decorated or uniquely formatted
  TOO_MUCH_DECORATION // 🖍️ Over-decorated, flashy but not focused
  MISALIGNED_CONTENT // 📐 Answers not matching questions or misordered
